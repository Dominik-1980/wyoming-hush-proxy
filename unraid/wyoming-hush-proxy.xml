<?xml version="1.0"?>
<Container version="2">
  <Name>wyoming-hush-proxy</Name>
  <Repository>ghcr.io/dominik-1980/wyoming-hush-proxy:0.2.0</Repository>
  <Registry>https://github.com/Dominik-1980/wyoming-hush-proxy/pkgs/container/wyoming-hush-proxy</Registry>
  <Network>bridge</Network>
  <Privileged>false</Privileged>
  <Support>https://github.com/Dominik-1980/wyoming-hush-proxy/issues</Support>
  <Project>https://github.com/Dominik-1980/wyoming-hush-proxy</Project>
  <Overview>Wyoming Sprachfilter Proxy. Lokale Hush-Verarbeitung vor einem frei wählbaren Wyoming-STT-Dienst. STT-Host/Port, maximale Absenkung und Aufnahme über die Weboberfläche einstellbar. 12 dB Voreinstellung; WAV-Aufnahme standardmäßig aus. Einzelne oder alle abgeschlossenen Aufnahmen nach Bestätigung löschbar.</Overview>
  <Category>HomeAutomation: MediaServer:Other</Category>
  <WebUI>http://[IP]:[PORT:10323]</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/Dominik-1980/wyoming-hush-proxy/main/unraid/wyoming-hush-proxy.xml</TemplateURL>
  <Icon/>
  <ExtraParams>--read-only --tmpfs /tmp:rw,noexec,nosuid,size=32m --cap-drop=ALL --security-opt=no-new-privileges:true --memory=512m --cpus=2</ExtraParams>
  <Config Name="Wyoming-Port" Target="10322" Default="10322" Mode="tcp" Type="Port" Display="always" Required="true" Mask="false">10322</Config>
  <Config Name="Weboberfläche" Target="10323" Default="10323" Mode="tcp" Type="Port" Display="always" Required="true" Mask="false">10323</Config>
  <Config Name="Initiales STT-Ziel (optional)" Target="UPSTREAM_URI" Default="" Description="tcp://stt-server:10300; alternativ Host/Port in der Weboberfläche konfigurieren. Gespeicherte UI-Einstellungen haben Vorrang." Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="Appdata" Target="/data" Default="/mnt/user/appdata/wyoming-hush-proxy" Mode="rw" Description="Einstellungen und Aufnahmen; Schreibrechte für UID99/GID100 erforderlich" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/wyoming-hush-proxy</Config>
  <Config Name="Aufnahmen maximal MB" Target="MAX_RECORDING_MB" Default="512" Type="Variable" Display="advanced" Required="true" Mask="false">512</Config>
  <Config Name="Maximale Audiodauer" Target="MAX_AUDIO_SECONDS" Default="60" Type="Variable" Display="advanced" Required="true" Mask="false">60</Config>
  <Config Name="Gleichzeitige Anfragen" Target="MAX_SESSIONS" Default="2" Type="Variable" Display="advanced" Required="true" Mask="false">2</Config>
</Container>
